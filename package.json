{
	"name": "github-action-repo-sync",
	"version": "5.0.7",
	"private": true,
	"description": "GitHub Action to detect and sync project metadata to GitHub.",
	"keywords": [
		"github-action",
		"action",
		"repo",
		"project",
		"metadata"
	],
	"homepage": "https://github.com/kitschpatrol/github-action-repo-sync",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/github-action-repo-sync.git"
	},
	"license": "MIT",
	"author": {
		"name": "Eric Mika",
		"email": "eric@ericmika.com",
		"url": "https://ericmika.com"
	},
	"type": "module",
	"scripts": {
		"build": "tsx scripts/build.ts",
		"clean-deep": "shx rm -f pnpm-lock.yaml && git clean -fdX",
		"fix": "ksc fix",
		"lint": "ksc lint",
		"release": "pnpm run build && bumpp --commit 'Release: %s' --all && ./scripts/sync-major-tag.sh",
		"test": "vitest run"
	},
	"devDependencies": {
		"@actions/core": "^3.0.1",
		"@actions/github": "^9.1.1",
		"@kitschpatrol/shared-config": "^8.14.0",
		"@octokit/rest": "^22.0.1",
		"@types/node": "~24.13.6",
		"bumpp": "^12.3.0",
		"esbuild": "^0.28.2",
		"metascope": "^0.13.0",
		"shx": "^0.4.0",
		"tsx": "^4.23.15",
		"typescript": "~6.0.3",
		"vitest": "^5.0.3"
	},
	"packageManager": "pnpm@12.15.0",
	"engines": {
		"node": "^24.16.0 || >=26.3.0"
	}
}
